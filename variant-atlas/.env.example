# Backend only. Copy to backend/.env. No secrets belong in frontend env files.
# ---- Server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:8500

DATA_BACKEND=local
LOCAL_DATA_DIR=
MONGODB_URI=
MONGODB_DATABASE=variant_atlas
# Use google with GOOGLE_API_KEY for Argon; configured access does not prove generation quota.
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1500
LLM_MAX_STEPS=6
# Optional override; otherwise FRONTEND_ORIGIN and its localhost/127.0.0.1 alias are allowed.
# CORS_ORIGINS=http://localhost:8500,http://127.0.0.1:8500

# ---- Real-data scientific workspace (separate from the synthetic fixture) ----
APP_PROFILE=local
DATA_MODE=real
# ASSET_ROOT: optional absolute path; defaults to variant-atlas/data/assets
GOOGLE_API_KEY=
ARGON_MODEL=gemini-4-argon
GOOGLE_THINKING_LEVEL=medium
GOOGLE_BACKGROUND=true
# Set exact companion IDs only when available to your account.
GEMINI_SPECIALIST_MODEL=
GEMINI_LIVE_MODEL=
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
VOYAGE_API_KEY=
WORKER_MODE=embedded
MAX_CONCURRENT_WORKERS=4
MAX_SPAWN_DEPTH=2
MAX_SPAWNED_TASKS=12
MAX_TOOL_CALLS=40
MAX_MODEL_REQUESTS=20
MAX_RUN_SECONDS=600
# Optional stop-after-response ceiling, not a prepaid spending guarantee:
# MAX_RUN_COST_USD=
